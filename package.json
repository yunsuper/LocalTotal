{
    "name": "local-total",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
        "dev:api": "npm run start:dev -w apps/api",
        "dev:web": "npm run dev -w apps/web -- -H 127.0.0.1 -p 3000"
    },
    "devDependencies": {
        "concurrently": "^9.0.0"
    }
}
